# URL publique de l'API boutique (Laravel, dossier API/) — sans slash final
NEXT_PUBLIC_API_URL=http://localhost:8100/api   # en dev séparé ; dans le conteneur unique : /api
# URL publique du site (SEO / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# URL interne de l'API vue depuis le serveur Next (réglages du site relus toutes les 60 s) — conteneur : http://127.0.0.1:8080/api
SITE_API_INTERNAL_URL=http://localhost:8100/api
